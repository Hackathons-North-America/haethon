{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["iad1"],
  "functions": {
    "app/api/discord/channel-worker/route.ts": {
      "experimentalTriggers": [{ "type": "queue/v2beta", "topic": "discord-channel-jobs" }]
    }
  },
  "crons": [
    {
      "path": "/api/cron/sync-discord",
      "schedule": "8 12 * * *"
    },
    {
      "path": "/api/cron/cleanup-hackathons",
      "schedule": "12 12 * * *"
    }
  ]
}
